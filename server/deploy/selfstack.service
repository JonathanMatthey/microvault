[Unit]
Description=SelfStack - Secure File Upload Service
After=network.target

[Service]
EnvironmentFile=/etc/selfstack.env
Type=simple
User=selfstack
Group=selfstack
WorkingDirectory=/var/lib/selfstack
ExecStart=/usr/local/bin/selfstack
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/selfstack
ReadOnlyPaths=/etc/selfstack

# Resource limits
LimitNOFILE=65536

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=selfstack

[Install]
WantedBy=multi-user.target
